      "stdout": "youtube/watch-list-track.json"
    },
    {
      "url": "https://www.youtube.com/watch?v=gHKT4uU8Zng&list=PLt5yu3-wZAlQAaPZ5Z-rJoTdbT-45Q7c0",
      "playlist": "yes",
      "stdout": "youtube/watch-list-playlist.json"
    },
    {
      "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ&list=RDdQw4w9WgXcQ",
      "playlist": "yes",
      "stdout": "youtube/mix.json",
      "note": "51 rows (recorded with -I 1:51): one more than the mix cap, so it resolves truncated."
    },
    {
      "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ&list=RDdQw4w9WgXcQ",
      "playlist": "no",
      "stdout": "youtube/mix-track.json",
      "note": "The seed video alone: what auto mode looks up before offering the mix."
    },
    {
      "url": "https://www.youtube.com/watch?v=jNQXAC9IVRw&list=RDjNQXAC9IVRw",
      "playlist": "yes",
      "stdout": "youtube/mix-unrecognized.json",
      "stderr": "errors/youtube-mix-unrecognized.log"
    },
    {
      "url": "https://www.youtube.com/@NoCopyrightSounds/videos",
      "stdout": "youtube/channel-videos.json"
    },
    {
      "url": "https://www.youtube.com/@NoCopyrightSounds",
