[
  "--ignore-config",
  "--no-update",
  "--color",
  "never",
  "--encoding",
  "utf-8",
  "--js-runtimes",
  "node:{NODE}",
  "--no-playlist",
  "-f",
  "ba[ext=m4a]/ba",
  "--socket-timeout",
  "20",
  "--retries",
  "3",
  "--fragment-retries",
  "3",
  "--retry-sleep",
  "fragment:exp=1:8",
  "--abort-on-unavailable-fragments",
  "--max-filesize",
  "200M",
  "--no-mtime",
  "-P",
  "{TEMPDIR}",
  "-o",
  "%(id)s.%(ext)s",
  "--print",
  "after_move:PREVIEW %(.{filepath})j",
  "--",
  "https://www.youtube.com/watch?v=jNQXAC9IVRw"
]
