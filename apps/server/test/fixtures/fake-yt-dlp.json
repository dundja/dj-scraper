{
  "rules": [
    {
      "url": "https://www.youtube.com/watch?v=jNQXAC9IVRw",
      "stdout": "youtube/video.json"
    },
    {
      "url": "https://music.youtube.com/watch?v=XNEnEBrHws8",
      "stdout": "youtube/music-track.json"
    },
    {
      "url": "https://www.youtube.com/playlist?list=PLt5yu3-wZAlQAaPZ5Z-rJoTdbT-45Q7c0",
      "stdout": "youtube/playlist.json"
    },
    {
      "url": "https://www.youtube.com/playlist?list=PLzH6n4zXuckpfMu_4Ff8E7Z1behQks5ba",
      "stdout": "youtube/playlist-capped.json",
      "note": "Recorded with -I 1:4: only rows 1-4 of 11 exist, so any wider -I still returns 4."
    },
    {
      "url": "https://www.youtube.com/playlist?list=PL4lCao7KL_QFodcLWhDpGCYnngnHtQ-Xf",
      "stdout": "youtube/playlist-empty.json"
    },
    {
      "url": "https://www.youtube.com/playlist?list=PLYwq8WOe86_xGmR7FrcJq8Sb7VW8K3Tt2",
      "stdout": "youtube/playlist-unavailable-entries.json",
      "note": "A window (rows 49-71 of 162): -I selects by those real indices."
    },
    {
      "url": "https://music.youtube.com/browse/MPREb_gTAcphH99wE",
      "stdout": "youtube/album.json"
    },
    {
      "url": "https://www.youtube.com/playlist?list=OLAK5uy_l1m0thk3g31NmIIz_vMIbWtyv7eZixlH0",
