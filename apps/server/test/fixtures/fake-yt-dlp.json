      "note": "An option this yt-dlp does not know (too old for our argv): optparse prints usage and exits 2."
    },
    {
      "url": "http://127.0.0.1:9/x",
      "stderr": "errors/connection-refused.log",
      "exit": 1
    },
    {
      "url": "notaurl",
      "stderr": "errors/invalid-url.log",
      "exit": 1,
      "note": "classifyUrl refuses it, so only a direct call passes it to yt-dlp."
    },
    {
      "url": "https://music.amazon.com/albums/B0000000000",
      "stderr": "errors/drm.log",
      "exit": 1,
      "note": "classifyUrl refuses Amazon Music as out of scope, so only a direct call passes it to yt-dlp."
    },
    {
