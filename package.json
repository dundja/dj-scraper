{
  "name": "dj-scraper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @dj-scraper/server --fail-if-no-match run start",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @dj-scraper/web --fail-if-no-match run test:e2e",
    "smoke": "pnpm --filter @dj-scraper/server --fail-if-no-match run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "catalog:"
  }
}
