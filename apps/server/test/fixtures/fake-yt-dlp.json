    {
      "url": "https://soundcloud.com/the-concept-band/world-on-fire-1",
      "args": [["--extractor-args", "soundcloud:formats=hls_aac"]],
      "stderr": "errors/soundcloud-no-formats.log",
      "exit": 1
    },
    {
      "url": "https://soundcloud.com/the-concept-band/world-on-fire-1",
      "args": ["--no-quiet", ["--match-filters", "format_id!*=preview"]],
      "stdout": "errors/preview-filter.log",
      "note": "Only --no-quiet prints the filter message (on stdout); quiet runs print nothing."
    },
    {
      "url": "https://soundcloud.com/the-concept-band/world-on-fire-1",
      "args": [["-f", "ba[format_id!*=preview]"]],
      "stderr": "errors/preview-format-unavailable.log",
      "exit": 1
    },
    {
      "url": "https://soundcloud.com/the-concept-band/world-on-fire-1",
